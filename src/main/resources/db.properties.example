# ============================================================
#  Database connection configuration (template file)
# ============================================================
#  Usage:
#    1. Copy this file to db.properties (do NOT push db.properties to git repo)
#       Windows PowerShell:  Copy-Item db.properties.example db.properties
#       Linux / macOS:       cp db.properties.example db.properties
#    2. Edit db.properties, replace the placeholders below with your own config
# ============================================================

jdbc.driver=com.mysql.cj.jdbc.Driver
# allowPublicKeyRetrieval=true fixes "Public Key Retrieval is not allowed" on MySQL 8.0
jdbc.url=jdbc:mysql://localhost:3306/auction_db?useSSL=false&serverTimezone=UTC&characterEncoding=UTF-8&useUnicode=true&allowPublicKeyRetrieval=true
jdbc.username=root
jdbc.password=your_mysql_password_here