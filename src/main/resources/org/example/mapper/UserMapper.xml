<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.example.mapper.UserMapper">

    <!-- 用户表所有列 -->
    <sql id="userColumns">
        id, username, password, phone, email, real_name, id_card,
        avatar, credit_score, balance, status, register_time, last_login_time
    </sql>

    <!-- 1. 按 ID 查询 -->
    <select id="findById" parameterType="int" resultType="User">
        SELECT <include refid="userColumns"/>
        FROM user
        WHERE id = #{id}
    </select>

    <!-- 2. 按用户名查询 -->
    <select id="findByUsername" parameterType="string" resultType="User">
        SELECT <include refid="userColumns"/>
        FROM user
        WHERE username = #{username}
    </select>

    <!-- 2b. 按手机号查询 -->
    <select id="findByPhone" parameterType="string" resultType="User">
        SELECT <include refid="userColumns"/>
        FROM user
        WHERE phone = #{phone}
    </select>

    <!-- 3. 登录: 按用户名 + 密码 -->
    <select id="login" parameterType="string" resultType="User">
        SELECT <include refid="userColumns"/>
        FROM user
        WHERE username = #{username} AND password = #{password} AND status = 0
    </select>

    <!-- 4. 注册: 插入用户 -->
    <insert id="insert" parameterType="User" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO user (username, password, phone, email, balance)
        VALUES (#{username}, #{password}, #{phone}, #{email}, #{balance})
    </insert>

    <!-- 5. 统计用户总数 -->
    <select id="countAll" resultType="int">
        SELECT COUNT(*) FROM user
    </select>

    <!-- 6. 查询所有用户 -->
    <select id="findAll" resultType="User">
        SELECT <include refid="userColumns"/>
        FROM user
        ORDER BY id ASC
    </select>

</mapper>