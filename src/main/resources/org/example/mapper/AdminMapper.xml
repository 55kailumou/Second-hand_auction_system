<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.example.mapper.AdminMapper">

    <sql id="adminColumns">
        id, admin_account, admin_password, admin_name, role, status,
        create_time, last_login_time
    </sql>

    <!-- 1. 按 ID 查询 -->
    <select id="findById" parameterType="int" resultType="Admin">
        SELECT <include refid="adminColumns"/>
        FROM admin
        WHERE id = #{id}
    </select>

    <!-- 2. 按账号查询（登录用） -->
    <select id="findByAccount" parameterType="string" resultType="Admin">
        SELECT <include refid="adminColumns"/>
        FROM admin
        WHERE admin_account = #{account}
        LIMIT 1
    </select>

    <!-- 3. 查询所有 -->
    <select id="findAll" resultType="Admin">
        SELECT <include refid="adminColumns"/>
        FROM admin
        ORDER BY id ASC
    </select>

    <!-- 4. 更新最后登录时间 -->
    <update id="updateLastLoginTime">
        UPDATE admin SET last_login_time = NOW() WHERE id = #{id}
    </update>

</mapper>
